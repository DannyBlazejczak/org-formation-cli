{
  "name": "aws-organization-formation",
  "version": "1.0.17-beta.2",
  "description": "Infrastructure as code solution for AWS Organizations",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "pre-commit": [
    "lint"
  ],
  "scripts": {
    "build": "tsc && tsc-alias",
    "prepublishOnly": "npm run build",
    "lint": "npx eslint './src/**/*.ts'",
    "lint:fix": "npx eslint --fix './src/**/*.ts'",
    "test": "npm run test:unit",
    "test:unit": "npx jest 'unit-test'",
    "test:ci": "npm run test:unit -- --ci --collect-coverage",
    "test:integration": "npx jest --runInBand 'integration-test'",
    "start": "npx --quiet ts-node -r tsconfig-paths/register cli.ts",
    "start:debug": "node --inspect -r ts-node/register -r tsconfig-paths/register cli.ts"
  },
  "files": [
    "dist/*",
    "resources/*"
  ],
  "bin": {
    "aws-organization-formation": "dist/cli.js",
    "org-formation": "dist/cli.js",
    "ofn": "dist/cli.js"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/org-formation/org-formation-cli.git"
  },
  "author": "Olaf Conijn",
  "license": "MIT",
  "dependencies": {
    "@aws-sdk/client-cloudformation": "3.1068.0",
    "@aws-sdk/client-ec2": "3.1068.0",
    "@aws-sdk/client-eventbridge": "3.1068.0",
    "@aws-sdk/client-iam": "3.1068.0",
    "@aws-sdk/client-organizations": "3.1068.0",
    "@aws-sdk/client-s3": "3.1068.0",
    "@aws-sdk/client-signer": "3.1068.0",
    "@aws-sdk/client-sts": "3.1068.0",
    "@aws-sdk/client-support": "3.1068.0",
    "@aws-sdk/credential-provider-ini": "3.972.53",
    "@aws-sdk/credential-provider-node": "3.972.55",
    "@aws-sdk/credential-providers": "3.1068.0",
    "@aws-sdk/lib-storage": "3.1068.0",
    "@aws-sdk/middleware-sdk-s3": "3.972.51",
    "@aws-sdk/middleware-signing": "3.972.17",
    "@smithy/property-provider": "4.3.7",
    "@smithy/types": "4.14.4",
    "archiver": "7.0.1",
    "commander": "2.20.3",
    "ini": "1.3.8",
    "js-yaml": "4.2.0",
    "md5": "2.3.0",
    "md5-file": "4.0.0",
    "memory-streams": "0.1.3",
    "minimatch": "3.1.5",
    "node-fetch": "2.7.0",
    "nunjucks": "3.2.4",
    "pascal-case": "3.1.2",
    "rc": "1.2.8",
    "tmp": "0.2.7",
    "unzipper": "0.12.3",
    "uuid": "11.1.1",
    "yamljs": "0.3.0"
  },
  "devDependencies": {
    "@types/archiver": "7.0.0",
    "@types/commander": "2.12.2",
    "@types/ini": "1.3.33",
    "@types/jest": "25.2.3",
    "@types/js-yaml": "4.0.9",
    "@types/md5": "2.3.5",
    "@types/minimatch": "3.0.5",
    "@types/node": "18.17.14",
    "@types/node-fetch": "2.6.9",
    "@types/nunjucks": "3.2.6",
    "@types/rc": "1.2.4",
    "@types/sinon": "7.5.2",
    "@types/tmp": "0.2.6",
    "@types/unzipper": "0.10.9",
    "@types/yamljs": "0.2.34",
    "@typescript-eslint/eslint-plugin": "4.33.0",
    "@typescript-eslint/parser": "4.33.0",
    "aws-sdk-client-mock": "3.0.0",
    "aws-sdk-client-mock-jest": "3.0.0",
    "eslint": "6.8.0",
    "eslint-plugin-import": "2.29.0",
    "eslint-plugin-prefer-arrow": "1.2.3",
    "jest": "29.7.0",
    "pre-commit": "1.2.2",
    "sinon": "14.0.2",
    "ts-jest": "29.4.11",
    "ts-mockito": "2.6.1",
    "ts-node": "10.9.2",
    "tsc-alias": "1.8.17",
    "tsconfig-paths": "4.2.0",
    "typescript": "5.9.3"
  },
  "keywords": [
    "AWS",
    "CloudFormation",
    "ControlTower",
    "StackSets",
    "tool"
  ]
}
